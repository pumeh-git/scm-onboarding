<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Opening Slack...</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, 'Segoe UI', Arial, sans-serif; background: #f4f5f7; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
  .card { background: #fff; border-radius: 14px; padding: 40px 48px; text-align: center; box-shadow: 0 4px 24px rgba(0,0,0,0.1); max-width: 420px; width: 100%; }
  .slack-logo { font-size: 48px; margin-bottom: 16px; }
  h1 { font-size: 20px; font-weight: 800; color: #111; margin-bottom: 8px; }
  p { font-size: 13px; color: #888; line-height: 1.6; margin-bottom: 20px; }
  .spinner { width: 36px; height: 36px; border: 3px solid #eee; border-top-color: #76B900; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 20px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .btn { display: inline-block; padding: 10px 24px; background: #4A154B; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; margin: 6px; }
  .btn-secondary { background: #f0f0f0; color: #333; }
  .status { font-size: 12px; color: #76B900; font-weight: 600; margin-top: 16px; }
</style>
</head>
<body>
<div class="card">
  <div class="slack-logo">💬</div>
  <div class="spinner" id="spinner"></div>
  <h1>Opening Slack...</h1>
  <p>The SCM Onboarding notification form is opening in your Slack app. If it doesn't open automatically, click the button below.</p>
  <a href="slack://shortcuts/Ft0B88R2RV44/9370c466951d616241fb50e9e92d782a" class="btn" id="slackBtn">Open in Slack App</a>
  <br>
  <a href="https://app.slack.com/client/T024NFZGE" class="btn btn-secondary">Open Slack in Browser</a>
  <div class="status" id="status">Launching Slack desktop app...</div>
</div>

<script>
  // Grab section from URL param if passed
  const params = new URLSearchParams(window.location.search);
  const section = params.get('section') || '';
  const name    = params.get('name') || '';

  // Update page if section passed
  if (section) {
    document.querySelector('p').textContent =
      `Notifying your manager that you completed "${decodeURIComponent(section)}". The Slack form is opening now.`;
  }

  // Try deep link immediately
  const deepLink = 'slack://shortcuts/Ft0B88R2RV44/9370c466951d616241fb50e9e92d782a';
  document.getElementById('slackBtn').href = deepLink;

  // Auto-trigger after short delay
  setTimeout(() => {
    window.location.href = deepLink;
  }, 800);

  // Update status after attempt
  setTimeout(() => {
    document.getElementById('spinner').style.display = 'none';
    document.getElementById('status').textContent = 'If Slack opened, fill in the form and hit Submit ✅';
  }, 2000);

  // Final fallback after 4s — open Slack web
  setTimeout(() => {
    const statusEl = document.getElementById('status');
    statusEl.innerHTML = 'Slack app not detected? <a href="https://app.slack.com/client/T024NFZGE" style="color:#76B900">Open Slack in browser →</a>';
  }, 4000);
</script>
</body>
</html>
